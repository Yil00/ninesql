DBeaverData/
credentials-config.json
!crates/ninesql-dbeaver/tests/fixtures/dbeaver-*/workspace6/General/.dbeaver/credentials-config.json
# DBeaver backups written next to the real files, never committed (fixtures included)
*credentials-config.json*.bak
.data-sources*.json.bak

# Dev environment state
dev/.state/
