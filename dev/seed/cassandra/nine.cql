-- "nine" sample dataset for Apache Cassandra (schema and small tables). Fake
-- data only. big_events (1 000 000 rows) is generated by seed.sh with COPY.

CREATE KEYSPACE IF NOT EXISTS nine
  WITH replication = {'class': 'SimpleStrategy', 'replication_factor': 1};
USE nine;

CREATE TABLE customers (
  id int PRIMARY KEY,
  name text,
  email text,
  country text,
  created_at timestamp
);

CREATE TABLE orders_by_customer (
  customer_id int,
  ordered_at timestamp,
  id int,
  product_id int,
  quantity int,
  status text,
  PRIMARY KEY ((customer_id), ordered_at, id)
) WITH CLUSTERING ORDER BY (ordered_at DESC, id ASC);

CREATE TYPE address (street text, city text, zip text);

-- One column per CQL type; row 3 is all NULLs.
CREATE TABLE all_types (
  id int PRIMARY KEY,
  c_ascii ascii,
  c_bigint bigint,
  c_blob blob,
  c_boolean boolean,
  c_date date,
  c_decimal decimal,
  c_double double,
  c_duration duration,
  c_float float,
  c_inet inet,
  c_int int,
  c_smallint smallint,
  c_text text,
  c_time time,
  c_timestamp timestamp,
  c_timeuuid timeuuid,
  c_tinyint tinyint,
  c_uuid uuid,
  c_varint varint,
  c_list list<int>,
  c_set set<text>,
  c_map map<text, int>,
  c_tuple tuple<text, int>,
  c_udt frozen<address>,
  c_vector vector<float, 3>
);

INSERT INTO all_types (id, c_ascii, c_bigint, c_blob, c_boolean, c_date, c_decimal, c_double, c_duration,
  c_float, c_inet, c_int, c_smallint, c_text, c_time, c_timestamp, c_timeuuid, c_tinyint, c_uuid, c_varint,
  c_list, c_set, c_map, c_tuple, c_udt, c_vector)
VALUES (1, 'ascii', 424242424242, 0xdeadbeef, true, '2026-11-14', 12345.678901, 2.718281828459045, 1d2h3m,
  3.14, '192.0.2.10', 4242, 42, 'text value with unicode: café, 日本', '13:37:00.123456789',
  '2026-11-14 13:37:00+0000', 50554d6e-29bb-11e5-b345-feff819cdc9f, 7, 6f1c0d2e-9a8b-4c3d-8e7f-1a2b3c4d5e6f,
  123456789012345678901234567890, [1, 2, 3], {'x', 'y'}, {'k': 1}, ('x', 1),
  {street: '1 Example Street', city: 'Nowhere', zip: '00000'}, [0.1, 0.2, 0.3]);
INSERT INTO all_types (id, c_ascii, c_bigint, c_blob, c_boolean, c_date, c_decimal, c_double, c_duration,
  c_float, c_inet, c_int, c_smallint, c_text, c_time, c_timestamp, c_tinyint, c_varint, c_list, c_map)
VALUES (2, '', 9223372036854775807, 0x, false, '1970-01-01', -99999999999999.999999, -1e300, 0s,
  -1.5, '::1', -2147483648, -32768, '', '00:00:00', '1970-01-01 00:00:00+0000', -128, -1, [], {});
INSERT INTO all_types (id) VALUES (3);

CREATE TABLE big_events (
  id bigint PRIMARY KEY,
  event_time timestamp,
  kind text,
  value double,
  payload text
);

CREATE TABLE nine_meta (key text PRIMARY KEY, value text);
